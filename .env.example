# Postgres connection string.
# Local without Docker: `npx prisma dev --name gympal --detach` then use the TCP URL it prints.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Max DB connections per server process. Keep 1 for `prisma dev`; use ~10 for real Postgres.
DATABASE_POOL_MAX="1"

# Docker Compose only (docs/DOCKER.md): password for the bundled Postgres, and optional host port.
POSTGRES_PASSWORD=""
# APP_PORT="3000"

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Other addresses people open the app from, comma-separated (another port, 127.0.0.1, a LAN IP for your phone)
# BETTER_AUTH_TRUSTED_ORIGINS="http://127.0.0.1:3000,http://192.168.1.20:3000"

# Optional: SMTP for "Forgot password?" emails. Without SMTP_HOST the sign-in page doesn't offer it.
# Port 465 uses TLS from the start; other ports (587) upgrade with STARTTLS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="GymPal <no-reply@example.com>"

# Optional: push reminders (morning weigh-in, training days). Without all three VAPID values
# Settings doesn't offer them. Make a key pair with: npx web-push generate-vapid-keys
# VAPID_SUBJECT is how push services can reach you: "mailto:you@example.com" or your site's URL.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
# Shared secret for POST /api/reminders/send, which sends the reminders that are due. Call it every
# few minutes with "Authorization: Bearer <CRON_SECRET>" (docker-compose's reminders service does).
# Make one with: openssl rand -base64 32
CRON_SECRET=""

# OpenAI (server-side only, never prefix with NEXT_PUBLIC_)
OPENAI_API_KEY=""
# Optional: any OpenAI-compatible provider that supports the Responses API,
# e.g. DeepSeek: OPENAI_BASE_URL="https://api.deepseek.com"
OPENAI_BASE_URL=""
# Model used for meal analysis (must support image input + structured outputs).
# DeepSeek: deepseek-flash (vision-capable). deepseek-v4-pro does NOT read images.
OPENAI_MODEL="gpt-5.4-mini"
# Model used for training plans and the coach chat
OPENAI_SMART_MODEL="gpt-5.5"
# Optional model for plan generation (defaults to OPENAI_SMART_MODEL). Plans are long
# structured outputs; a fast model keeps generation under ~30s (DeepSeek: deepseek-flash).
OPENAI_PLAN_MODEL=""
# Optional reasoning effort for the smart model: minimal | low | medium | high.
# "low" roughly halves plan/coach latency on reasoning models.
OPENAI_REASONING_EFFORT=""

# Set to 1 to return fixture responses instead of calling OpenAI (tests / no key)
AI_MOCK="0"

# Per-user daily AI limits
AI_LIMIT_MEAL_PER_DAY="30"
AI_LIMIT_PLAN_PER_DAY="5"
AI_LIMIT_CHAT_PER_DAY="50"
AI_LIMIT_PROCUREMENT_PER_DAY="10"
AI_LIMIT_EXERCISE_PER_DAY="20"
